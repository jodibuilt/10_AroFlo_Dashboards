# AroFlo API v1 (HMAC-SHA512 signed, zone based). This app only ever READS
# from AroFlo. Get these from Site Administration > Settings > General > AroFlo API.
AROFLO_API_BASE_URL=https://api.aroflo.com/
AROFLO_SECRET_KEY=
AROFLO_UENCODED=
AROFLO_PENCODED=
AROFLO_ORG_ENCODED=
# Public IP of the machine making requests, if AroFlo requires it for your account.
AROFLO_HOST_IP=

# Web server port. App Service sets PORT itself — leave it unset there.
PORT=4300

# There is no refresh interval: AroFlo is only read when someone presses
# "Refresh from AroFlo" on a report page — never on a timer, never at startup.
# AroFlo allows this API login a fixed number of requests a day (2,000 on the
# TTS account), shared with everything else that uses it, and one refresh
# costs a request per page of each zone. See README.

# How far back the reports reach, in months. Work orders, invoices and
# payments are loaded from the 1st of the month this many months before the
# current one (2 = this month and the two before it). Asked for without a date
# AroFlo returns only the last 30 days, so nothing older than this setting is
# in any report. Each extra month adds roughly 15 requests to a refresh on the
# TTS account, and a zone stops at PAGE_SIZE x MAX_PAGES_PER_ZONE records.
REPORT_LOOKBACK_MONTHS=2

# Pause between fetching each zone (Tasks, Invoices, Payments) during a
# refresh, so zones are never hit back-to-back. Milliseconds.
INTER_ZONE_DELAY_MS=750

# Max outbound AroFlo API requests per second / per minute. AroFlo's documented v1
# limits are 3/sec and 120/min; defaults here are much more conservative.
RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_PER_MINUTE=60

# Records requested per page when paging through a zone, and a hard cap on pages
# per zone per refresh (safety net against accidentally pulling a huge result set).
PAGE_SIZE=200
MAX_PAGES_PER_ZONE=25

# Minimum seconds between presses of Refresh (POST /api/refresh), across all
# users. Each one spends requests from the shared daily allowance.
MIN_MANUAL_REFRESH_INTERVAL_SECONDS=30

# Task "status" values (Tasks zone) treated as complete/closed — case-insensitive.
COMPLETED_TASK_STATUSES=Completed,Archived

# Invoice "status" values (Invoices zone) treated as fully processed/paid —
# case-insensitive.
CLOSED_INVOICE_STATUSES=processed,paid

# Log level: error | warn | info | debug
LOG_LEVEL=info

# --- Local storage ---
# Two small SQLite files: sign-in accounts/sessions, and nav visibility +
# saved Reports edits. Relative to the project root unless absolute. On App
# Service these MUST point under /home (e.g. /home/data/...), or they are
# wiped on every redeploy.
AUTH_DB_PATH=data/auth.sqlite
APP_DB_PATH=data/dashboards.sqlite

# --- Auth ---
# ADMIN_USERNAME/ADMIN_PASSWORD are authoritative for that one account on
# EVERY boot — change the password here and restart to reset it (this also
# logs out any active session for that account). If no users exist at all and
# these are unset, the app refuses to start. Other accounts created via
# Settings > Manage users are unaffected.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=af_session
# "true" whenever the app is served over HTTPS (always on App Service). Leave
# false for local http://localhost, where a secure cookie is silently dropped
# and login appears to do nothing.
COOKIE_SECURE=false

# --- Reports ---
# The time zone the reports run on: what day "today" is (overdue, days late,
# this month) and how times are shown — for everyone, whatever the server's
# or their browser's clock is set to. Empty = Australia/Adelaide.
REPORT_TIME_ZONE=
# Priorities are named live from AroFlo's own priority list, and placed on the
# P1-P5 / PM scale by name: "P2" and "AP2" are both level 2, "PM" and "SM" are
# both PM. Neither setting below is normally needed.
# Fallback {priority id: name} for an id AroFlo's priority list doesn't return.
KPI_PRIORITY_LABELS_JSON=
# {priority name: P-code} for a name that doesn't state its level, e.g.
# {"Emergency":"P1"}. An entry here overrides the level read from the name.
KPI_PRIORITY_CODE_MAP_JSON=
# P-code -> SLA % targets. Empty = built-in defaults.
KPI_REPORTING_PRIORITY_TARGETS_JSON=
# {"Real client name": "Short label"} for the Reports client filter. Empty =
# Ventia + South Australian Housing Trust (SAHA).
KPI_TARGET_CLIENTS_JSON=
# Substatuses that say why a late job was held up — the breakdown tables'
# "Delay Reason". Comma-separated; spacing, case and punctuation are ignored.
# Empty = Non Access, Materials Ordered, On Hold/Materials Required, Sent to
# Procurement. Only ever a reason on a job that is past due. A late job in
# none of these has its notes searched instead (src/delayReason.js).
KPI_DELAY_REASON_SUBSTATUSES=
KPI_REPORT_TITLE=
KPI_REPORT_SUBTITLE=
# Invoice statuses that count as "submitted", and the lifecycle order for the
# Invoices by Status table. Empty = approved, in progress, processed (in
# progress has gone to the client; the page says how many are) / AroFlo's
# five statuses.
KPI_SUBMITTED_INVOICE_STATUSES=
KPI_INVOICE_STATUS_ORDER=
