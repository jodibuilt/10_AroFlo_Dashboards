# AroFlo API v1 (HMAC-SHA512 signed, zone based). This app only ever READS
# from AroFlo. Get these from Site Administration > Settings > General > AroFlo API.
AROFLO_API_BASE_URL=https://api.aroflo.com/
AROFLO_SECRET_KEY=
AROFLO_UENCODED=
AROFLO_PENCODED=
AROFLO_ORG_ENCODED=
# Public IP of the machine making requests, if AroFlo requires it for your account.
AROFLO_HOST_IP=

# Web server port. App Service sets PORT itself — leave it unset there.
PORT=4300

# How often cached AroFlo data is refreshed in the background, in minutes.
REFRESH_INTERVAL_MINUTES=10

# Pause between fetching each zone (Tasks, Invoices, Payments) during a
# refresh, so zones are never hit back-to-back. Milliseconds.
INTER_ZONE_DELAY_MS=750

# Max outbound AroFlo API requests per second / per minute. AroFlo's documented v1
# limits are 3/sec and 120/min; defaults here are much more conservative.
RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_PER_MINUTE=60

# Records requested per page when paging through a zone, and a hard cap on pages
# per zone per refresh (safety net against accidentally pulling a huge result set).
PAGE_SIZE=200
MAX_PAGES_PER_ZONE=25

# Minimum seconds between manual POST /api/refresh calls.
MIN_MANUAL_REFRESH_INTERVAL_SECONDS=30

# Task "status" values (Tasks zone) treated as complete/closed — case-insensitive.
COMPLETED_TASK_STATUSES=Completed,Archived

# Invoice "status" values (Invoices zone) treated as fully processed/paid —
# case-insensitive.
CLOSED_INVOICE_STATUSES=processed,paid

# How far back to look for Payments-zone records when computing paid/unpaid
# status on invoices.
PAYMENTS_LOOKBACK_DAYS=180

# Log level: error | warn | info | debug
LOG_LEVEL=info

# --- Local storage ---
# Two small SQLite files: sign-in accounts/sessions, and nav visibility +
# saved Reports edits. Relative to the project root unless absolute. On App
# Service these MUST point under /home (e.g. /home/data/...), or they are
# wiped on every redeploy.
AUTH_DB_PATH=data/auth.sqlite
APP_DB_PATH=data/dashboards.sqlite

# --- Auth ---
# ADMIN_USERNAME/ADMIN_PASSWORD are authoritative for that one account on
# EVERY boot — change the password here and restart to reset it (this also
# logs out any active session for that account). If no users exist at all and
# these are unset, the app refuses to start. Other accounts created via
# Settings > Manage users are unaffected.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=af_session
# "true" whenever the app is served over HTTPS (always on App Service). Leave
# false for local http://localhost, where a secure cookie is silently dropped
# and login appears to do nothing.
COOKIE_SECURE=false

# --- Reports ---
# Priority-ID -> label map. Leave empty to use the built-in default (this
# account's own confirmed values) — see src/config.js.
KPI_PRIORITY_LABELS_JSON=
# Label -> P-code map and P-code -> SLA % targets. Empty = built-in defaults.
KPI_PRIORITY_CODE_MAP_JSON=
KPI_REPORTING_PRIORITY_TARGETS_JSON=
# {"Real client name": "Short label"} for the Reports client filter. Empty =
# Ventia + South Australian Housing Trust (SAHA).
KPI_TARGET_CLIENTS_JSON=
# Substatuses that count as a "delay reason" in the breakdown tables. A
# business decision — empty until confirmed.
KPI_DELAY_REASON_SUBSTATUSES=
KPI_REPORT_TITLE=
KPI_REPORT_SUBTITLE=
# Invoice statuses that count as "submitted", and the lifecycle order for the
# Invoices by Status table. Empty = approved,processed / the four AroFlo statuses.
KPI_SUBMITTED_INVOICE_STATUSES=
KPI_INVOICE_STATUS_ORDER=
